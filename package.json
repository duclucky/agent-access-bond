{
  "name": "agent-access-bond",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "lint:contracts": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/lint-contracts.ps1",
    "test:direct": ".venv\\Scripts\\python.exe -m pytest tests/direct -q",
    "test:deployment": "node --test tests/scripts/*.test.mjs",
    "test:frontend": "npm --workspace frontend test",
    "deploy:studionet": "node scripts/deploy-agent-access-bond-studionet.mjs",
    "lint": "npm --workspace frontend run lint",
    "build": "npm --workspace frontend run build",
    "check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check.ps1"
  },
  "devDependencies": {
    "genlayer-js": "1.1.8"
  }
}
